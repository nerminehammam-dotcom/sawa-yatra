# Copy to .env.local and fill in. Nothing here is committed.

# --- Canonical domain -------------------------------------------------------
# Unset, the site falls back to http://localhost:3000 and stays noindex.
# Setting this is a LAUNCH decision, not a configuration step: it switches
# indexing on and fixes every absolute URL in the social metadata at once.
NEXT_PUBLIC_SITE_URL=

# --- Form delivery ----------------------------------------------------------
# All three are required together. With any one missing the email adapter is
# unconfigured, which outside production falls back to the development mock and
# in production is a hard 503 - never a silent success. See lib/forms/adapters.ts.
#
# RESEND_API_KEY           from https://resend.com - begins "re_"
# SAWAYATRA_FORM_SENDER    an address on a domain verified with Resend. Until
#                          sawayatra.com is verified, Resend's test sender
#                          onboarding@resend.dev works, but can only deliver to
#                          the address that owns the Resend account.
# SAWAYATRA_FORM_RECIPIENT where enquiries arrive.
RESEND_API_KEY=
SAWAYATRA_FORM_SENDER=
SAWAYATRA_FORM_RECIPIENT=

# --- Analytics --------------------------------------------------------------
# No analytics code exists in this repository yet, so this is a placeholder for
# a decision rather than a switch. Blocked on the privacy basis and the consent
# wording - see audit/pending-decisions.md, PD-01.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
