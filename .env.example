# Release 1 runs safely without credentials. Forms use the documented mock adapter.
NEXT_PUBLIC_FORM_MODE=mock

# Required before launch for canonical URLs, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=

# Supply only when a live form service is approved and implemented.
# RESEND_API_KEY=
# SAWAYATRA_FORM_ENDPOINT=

# Analytics remains disabled until the domain, consent decision, and privacy basis are approved.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
